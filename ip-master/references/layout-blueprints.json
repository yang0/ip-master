{
  "version": 2,
  "description": "Text-only composition methods. Each method is adapted to the user's theme; sample-image positions and visual elements are never copied.",
  "blueprints": [
    {"id":"layout-001","layout_principle":"三分法构图","translation_rule":"将画面分为三段，把核心叙事放在分割线或交点附近，其余区域服务留白与补充。"},
    {"id":"layout-002","layout_principle":"九宫格构图","translation_rule":"用九个等比区域组织信息，在一个交点或中心单元确立主视觉，其余单元承担辅助。"},
    {"id":"layout-003","layout_principle":"黄金分割构图","translation_rule":"将主视觉安排在自然分割比例附近，用不等比例的空间建立舒适主次。"},
    {"id":"layout-004","layout_principle":"对称构图","translation_rule":"以中轴建立左右或上下均衡，让两侧内容在重量上呼应而非复制。"},
    {"id":"layout-005","layout_principle":"非对称构图","translation_rule":"让大小、位置或密度不对等，但以视觉重量重新取得稳定平衡。"},
    {"id":"layout-006","layout_principle":"均衡式构图","translation_rule":"分散主次内容的视觉重量，在画面两侧或上下维持稳定而不机械的平衡。"},
    {"id":"layout-007","layout_principle":"上下构图","translation_rule":"将信息分为上、下两个叙事层，上层提出主题，下层完成主体或结果。"},
    {"id":"layout-008","layout_principle":"前后构图","translation_rule":"建立前景、中景、背景三层：前景可用与主题相关的大型道具或局部角色，中景承载角色或核心事件，背景提供环境；以遮挡、尺度和清晰度区分纵深。标题位置由主题与视觉风格决定。"},
    {"id":"layout-009","layout_principle":"水平构图","translation_rule":"按横向层带展开信息，让阅读沿水平方向有序推进。"},
    {"id":"layout-010","layout_principle":"垂直构图","translation_rule":"沿纵向建立主线，让内容自上而下或自下而上递进。"},
    {"id":"layout-011","layout_principle":"开放式构图","translation_rule":"让视觉线索向画框外延伸，保留未封闭的空间感和想象余地。"},
    {"id":"layout-012","layout_principle":"封闭式构图","translation_rule":"让主体与辅助内容围合成完整视觉单元，强化聚焦与稳定感。"},
    {"id":"layout-013","layout_principle":"满版构图","translation_rule":"让主题内容覆盖主要画面，以强面积和近距离建立冲击力。"},
    {"id":"layout-014","layout_principle":"留白式构图","translation_rule":"主动压缩内容面积，用大面积空白衬托少量关键主题。"},
    {"id":"layout-015","layout_principle":"密集式构图","translation_rule":"将相关信息紧凑编排，靠清晰分层避免拥挤和无序。"},
    {"id":"layout-016","layout_principle":"疏朗式构图","translation_rule":"减少同时出现的元素，为每个关键信息保留充足呼吸空间。"},
    {"id":"layout-017","layout_principle":"疏密对比构图","translation_rule":"用一个密集信息区与一个开阔区域形成节奏对比，聚焦阅读入口。"},
    {"id":"layout-018","layout_principle":"单点构图","translation_rule":"只设置一个不可替代的视觉焦点，其余内容全部退后支持它。"},
    {"id":"layout-019","layout_principle":"双点构图","translation_rule":"建立两个有关系的焦点，并通过视线、动作或信息关系让读者在两点间往返。"},
    {"id":"layout-020","layout_principle":"多点构图","translation_rule":"布置多个同主题焦点，以距离和层级组织浏览顺序，避免同时争夺注意力。"},
    {"id":"layout-021","layout_principle":"S形构图","translation_rule":"让主体、动作或信息沿柔和的S形路径展开，形成自然引导。"},
    {"id":"layout-022","layout_principle":"C形构图","translation_rule":"让内容围绕一个开放弧线组织，把视线带向内侧焦点。"},
    {"id":"layout-023","layout_principle":"Z形构图","translation_rule":"让标题、主体和补充内容沿折返路径依次出现，形成快速扫描节奏。"},
    {"id":"layout-024","layout_principle":"V形构图","translation_rule":"让两条视觉力量向一个主题焦点汇聚，形成明确的落点。"},
    {"id":"layout-025","layout_principle":"X形构图","translation_rule":"用两条交叉的叙事方向连接信息，交会处承担关键冲突或焦点。"},
    {"id":"layout-026","layout_principle":"放射式构图","translation_rule":"由一个中心向外分发关联内容，强调能量、传播或影响范围。"},
    {"id":"layout-027","layout_principle":"向心式构图","translation_rule":"让周边元素共同指向核心，强化凝聚和中心主题。"},
    {"id":"layout-028","layout_principle":"离心式构图","translation_rule":"让核心向外扩展多个相关线索，表现扩散、延展或发散思考。"},
    {"id":"layout-029","layout_principle":"环绕式构图","translation_rule":"以核心主题为中心安排环绕信息，形成完整的关系网络。"},
    {"id":"layout-030","layout_principle":"框架式构图","translation_rule":"借助主题相关的边界或前景形成内框，引导观看进入核心区域。"},
    {"id":"layout-031","layout_principle":"三角构图","translation_rule":"以三个关键点建立稳定关系，最高权重放在顶点或主边。"},
    {"id":"layout-032","layout_principle":"倒三角构图","translation_rule":"将视觉重量压向上部两侧或下方顶点，营造张力与下沉感。"},
    {"id":"layout-033","layout_principle":"圆形构图","translation_rule":"让内容围绕中心形成闭合阅读循环，增强聚焦和完整感。"},
    {"id":"layout-034","layout_principle":"椭圆构图","translation_rule":"以横向或纵向延展的围合关系组织主体，兼顾中心和方向感。"},
    {"id":"layout-035","layout_principle":"方形构图","translation_rule":"以稳定的中心区域承载主题，外围只保留必要补充。"},
    {"id":"layout-036","layout_principle":"矩形构图","translation_rule":"用明确的横竖比例分区，使主画面与文字信息形成秩序。"},
    {"id":"layout-037","layout_principle":"菱形构图","translation_rule":"以中央斜向扩张的四点关系组织内容，让注意力向中心收束。"},
    {"id":"layout-038","layout_principle":"十字构图","translation_rule":"以横纵两条信息轴组织主题，使中心交会处成为核心。"},
    {"id":"layout-039","layout_principle":"T形构图","translation_rule":"以一条主轴承载主题，用横向部分提供标题、关系或信息延展。"},
    {"id":"layout-040","layout_principle":"L形构图","translation_rule":"用互相垂直的两条视觉边建立空间转折，并将主体安放在转折关系中。"},
    {"id":"layout-041","layout_principle":"单点聚焦构图","translation_rule":"将所有对比和留白集中服务一个明确焦点，不建立第二主角。"},
    {"id":"layout-042","layout_principle":"多点平衡构图","translation_rule":"让多个焦点分担信息，但通过大小和间隔维持整体平衡。"},
    {"id":"layout-043","layout_principle":"群组式构图","translation_rule":"按语义把多个元素归为一个群组，让群组整体与其他信息形成主次。"},
    {"id":"layout-044","layout_principle":"分组式构图","translation_rule":"将复杂内容拆成数个可独立阅读的小组，并保持组间边界清楚。"},
    {"id":"layout-045","layout_principle":"聚合式构图","translation_rule":"让分散线索逐步聚到一个核心结果，突出收束与结论。"},
    {"id":"layout-046","layout_principle":"分散式构图","translation_rule":"将相关元素有意拉开，通过共同主题和节奏维持关联。"},
    {"id":"layout-047","layout_principle":"集中式构图","translation_rule":"把关键内容压缩在一个区域，其他区域以留白或弱信息让出注意力。"},
    {"id":"layout-048","layout_principle":"扩散式构图","translation_rule":"从核心向外释放信息层级，表现传播、影响或丰富性。"},
    {"id":"layout-049","layout_principle":"层叠式构图","translation_rule":"以多个前后覆盖的内容层表达关系，清楚区分每层的重要度。"},
    {"id":"layout-050","layout_principle":"阶梯式构图","translation_rule":"让信息按级别逐步上升或下降，表现步骤、成长或递进。"},
    {"id":"layout-051","layout_principle":"重复式构图","translation_rule":"重复同类内容建立节奏，并用一个变化项作为重点。"},
    {"id":"layout-052","layout_principle":"渐变式构图","translation_rule":"让大小、密度或状态平滑变化，引导视线沿变化方向移动。"},
    {"id":"layout-053","layout_principle":"节奏式构图","translation_rule":"以有规律的间隔和重复组织信息，形成可感知的视觉节拍。"},
    {"id":"layout-054","layout_principle":"韵律式构图","translation_rule":"让重复元素在大小、距离或方向上有变化，形成柔和而连续的阅读节奏。"},
    {"id":"layout-055","layout_principle":"对比式构图","translation_rule":"通过主题中真正存在的差异建立主次或冲突，不从样图继承任何颜色方案。"},
    {"id":"layout-056","layout_principle":"呼应式构图","translation_rule":"让两个相隔区域以动作、形态或叙事关系互相回应。"},
    {"id":"layout-057","layout_principle":"镜像式构图","translation_rule":"以中轴两侧的对应关系建立对照，允许内容不同但重量相当。"},
    {"id":"layout-058","layout_principle":"轴线式构图","translation_rule":"沿一条明确轴线排列信息，让轴线承担阅读秩序。"},
    {"id":"layout-059","layout_principle":"中轴构图","translation_rule":"以画面中轴承载主主题，在两侧安排平衡的辅助内容。"},
    {"id":"layout-060","layout_principle":"偏轴构图","translation_rule":"有意偏离中轴设置主重心，并以留白维持张力和平衡。"},
    {"id":"layout-061","layout_principle":"网格式构图","translation_rule":"用一致的行列规则组织信息，让模块可快速比较和扫描。"},
    {"id":"layout-062","layout_principle":"模块化构图","translation_rule":"将主题拆为可组合的独立模块，并设置一至两个主模块。"},
    {"id":"layout-063","layout_principle":"分栏式构图","translation_rule":"将信息按列分工，每列承担不同层级或不同维度。"},
    {"id":"layout-064","layout_principle":"分割式构图","translation_rule":"用清晰区域边界分隔两种内容或状态，突出它们的关系。"},
    {"id":"layout-065","layout_principle":"区块式构图","translation_rule":"按内容类型组织成大小不同的区块，以面积体现优先级。"},
    {"id":"layout-066","layout_principle":"矩阵式构图","translation_rule":"用多行多列承载同类信息，令一个单元成为主要入口。"},
    {"id":"layout-067","layout_principle":"棋盘式构图","translation_rule":"让内容以交替节奏分布，建立丰富但有序的比较关系。"},
    {"id":"layout-068","layout_principle":"卡片式构图","translation_rule":"把多条信息做成独立可读单元，突出第一张或关键卡片。"},
    {"id":"layout-069","layout_principle":"拼贴式构图","translation_rule":"把异质但相关的内容片段拼接为整体，用重叠和层级形成叙事。"},
    {"id":"layout-070","layout_principle":"蒙太奇构图","translation_rule":"以多个片段并置表达时间、地点或观点的关联，建立整体叙事。"},
    {"id":"layout-071","layout_principle":"引导线构图","translation_rule":"从主题环境中寻找自然引导线，将视线带向核心内容。"},
    {"id":"layout-072","layout_principle":"透视构图","translation_rule":"用近大远小和收束方向建立空间深度，使注意力走向远端焦点。"},
    {"id":"layout-073","layout_principle":"纵深构图","translation_rule":"安排由近到远的多个空间层次，让主题在深度中展开。"},
    {"id":"layout-074","layout_principle":"近大远小构图","translation_rule":"让近处元素更大更清晰，远处元素更小更弱，以突出距离关系。"},
    {"id":"layout-075","layout_principle":"前景构图","translation_rule":"用与主题相关的前景元素先建立入口，再把核心事件放在其后。"},
    {"id":"layout-076","layout_principle":"中景构图","translation_rule":"让核心事件在中景发生，前景和背景仅提供必要空间层次。"},
    {"id":"layout-077","layout_principle":"背景构图","translation_rule":"让环境本身承担主叙事，角色或物件作为小尺度线索嵌入其中。"},
    {"id":"layout-078","layout_principle":"层次构图","translation_rule":"按前后、大小或信息权重安排多个层次，确保每层职责不同。"},
    {"id":"layout-079","layout_principle":"空间构图","translation_rule":"利用可进入、可穿行或可停留的空间关系组织主体与视线。"},
    {"id":"layout-080","layout_principle":"深度构图","translation_rule":"通过前后遮挡、尺度递减和远近清晰度拉开画面深度。"},
    {"id":"layout-081","layout_principle":"斜线构图","translation_rule":"让主题的动作或环境线索沿斜向推进，制造方向与动势。"},
    {"id":"layout-082","layout_principle":"曲线构图","translation_rule":"让主体关系沿自然曲线展开，以柔和路径引导阅读。"},
    {"id":"layout-083","layout_principle":"折线构图","translation_rule":"用转折路径串联多个信息点，创造停顿与推进的节奏。"},
    {"id":"layout-084","layout_principle":"波浪线构图","translation_rule":"让多个内容点沿起伏节奏排列，形成连续而轻快的浏览路径。"},
    {"id":"layout-085","layout_principle":"交叉线构图","translation_rule":"让两条主题相关的行动或信息方向交会，突出相遇或冲突。"},
    {"id":"layout-086","layout_principle":"平行线构图","translation_rule":"用平行的内容方向制造秩序、速度或对照，避免彼此干扰。"},
    {"id":"layout-087","layout_principle":"重心构图","translation_rule":"将主要视觉重量放在一个稳定重心，并用次要元素平衡周边。"},
    {"id":"layout-088","layout_principle":"偏重心构图","translation_rule":"把重心明确放在一侧，用另一侧留白或轻信息制造张力。"},
    {"id":"layout-089","layout_principle":"视觉中心构图","translation_rule":"先确定唯一视觉中心，再让标题和辅助信息围绕它服务。"},
    {"id":"layout-090","layout_principle":"视觉动线构图","translation_rule":"用角色视线、动作、物件关系或环境方向设计连续的浏览路线。"},
    {"id":"layout-091","layout_principle":"动势构图","translation_rule":"以动作方向、倾斜关系或即将发生的事件制造前进感。"},
    {"id":"layout-092","layout_principle":"静态构图","translation_rule":"以稳定、简洁和克制的关系呈现主题，减少不必要的方向冲突。"},
    {"id":"layout-093","layout_principle":"主次构图","translation_rule":"明确一个主内容与若干次内容，以大小、清晰度和留白拉开等级。"},
    {"id":"layout-094","layout_principle":"开合构图","translation_rule":"让一部分内容展开、一部分收束，在开放与聚焦之间形成节奏。"},
    {"id":"layout-095","layout_principle":"虚实构图","translation_rule":"让主主题清晰具体，辅助层以弱化或暗示的方式退后服务层次。"},
    {"id":"layout-096","layout_principle":"明暗构图","translation_rule":"按主题需要用光暗关系组织视觉重量，不沿用样图的具体色彩。"},
    {"id":"layout-097","layout_principle":"色块构图","translation_rule":"以主题所需的少量大面积色彩分区组织信息，颜色由当前视觉风格决定。"},
    {"id":"layout-098","layout_principle":"色彩对比构图","translation_rule":"围绕用户指定或主题适配的颜色建立对比焦点，不继承样图配色。"},
    {"id":"layout-099","layout_principle":"大小对比构图","translation_rule":"通过主体和辅助元素的尺度差异建立第一阅读重点。"},
    {"id":"layout-100","layout_principle":"动静对比构图","translation_rule":"让一个动态线索与一个稳定锚点并置，形成节奏和对照。"}
  ]
}
